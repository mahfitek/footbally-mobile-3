{
  "expo": {
    "name": "Footbally",
    "slug": "footbally",
    "scheme": "footbally",
    "version": "1.0.0",
    "description": "Futbolcuların, takımların ve scoutların buluşma noktası",
    "primaryColor": "#FFB347",
    "orientation": "portrait",
    "icon": "./assets/logo-icon-square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.footbally.app",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram",
          "twitter",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.footbally.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-icon-square.png",
        "backgroundColor": "#060A12"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Footbally, video analizi ve profil fotoğrafın için galerine erişim istiyor.",
          "cameraPermission": "Footbally profil fotoğrafı çekmenize izin verir.",
          "microphonePermission": "Footbally video kaydı için mikrofon erişimi gerektirir."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-mail-composer",
      [
        "expo-media-library",
        {
          "photosPermission": "Footbally, oyuncu kartını galerine kaydetmek için erişim istiyor.",
          "savePhotosPermission": "Footbally, oyuncu kartını galerine kaydetmek için erişim istiyor."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-icon-square.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5c7da171-4aeb-470d-8fe0-5f3ba986fa63"
      }
    },
    "owner": "osmantemur"
  }
}
